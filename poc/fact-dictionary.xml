        <Dependency path="/entrancePlanningApprovalAttached"/>
        <Dependency path="/entranceOwnershipAttached"/>
        <Dependency path="/entranceRecordedPlanAttached"/>
        <Dependency path="/entranceConstructionPlanAttached"/>
        <Dependency path="/entranceCostEstimateAttached"/>
        <Dependency path="/entranceScheduleAttached"/>
        <Any><Not><Dependency path="/entranceTrafficOperationalAnalysisRequired"/></Not><Dependency path="/entranceTrafficAnalysisAttached"/></Any>
        <Any><Not><Dependency path="/entrancePedestrianEvidenceRequired"/></Not><Dependency path="/entrancePedestrianEvidenceAttached"/></Any>
      </All>
    </Any></Derived></Fact>
    <Fact path="/entranceRequirementsSatisfied"><Derived><All><Dependency path="/entranceRequiredAnswersComplete"/><Dependency path="/entranceDocumentsComplete"/></All></Derived></Fact>

