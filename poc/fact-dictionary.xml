    <Fact path="/includesGeneralUtilityWork"><Writable><Boolean/></Writable></Fact>
    <Fact path="/includesSmallWirelessFacilities"><Writable><Boolean/></Writable></Fact>
    <Fact path="/includesEntranceWork"><Writable><Boolean/></Writable></Fact>
    <Fact path="/includesUtilityWork"><Derived><Any><Dependency path="/includesGeneralUtilityWork"/><Dependency path="/includesSmallWirelessFacilities"/></Any></Derived></Fact>
