    <Fact path="/entrancePlanningApprovalRequiredByEntrance"><Derived><Dependency path="/entrancePermitRequested"/></Derived></Fact>
    <Fact path="/entranceOwnershipRequiredByEntrance"><Derived><Dependency path="/entrancePermitRequested"/></Derived></Fact>
    <Fact path="/entranceRecordedPlanRequiredByEntrance"><Derived><Dependency path="/entrancePermitRequested"/></Derived></Fact>
    <Fact path="/entranceConstructionPlanRequiredByEntrance"><Derived><Dependency path="/entrancePermitRequested"/></Derived></Fact>
    <Fact path="/entranceCostEstimateRequiredByEntrance"><Derived><Dependency path="/entrancePermitRequested"/></Derived></Fact>
    <Fact path="/entranceScheduleRequiredByEntrance"><Derived><Dependency path="/entrancePermitRequested"/></Derived></Fact>
    <Fact path="/entranceTrafficAnalysisRequiredByEntrance"><Derived><All><Dependency path="/entrancePermitRequested"/><Dependency path="/entranceTrafficOperationalAnalysisRequired"/></All></Derived></Fact>
    <Fact path="/entrancePedestrianEvidenceRequiredByEntrance"><Derived><All><Dependency path="/entrancePermitRequested"/><Dependency path="/entrancePedestrianEvidenceRequired"/></All></Derived></Fact>
    <Fact path="/entrancePlanningApprovalReason"><Derived><String>An Entrance Permit requires evidence of planning and zoning approval.</String></Derived></Fact>
    <Fact path="/entranceOwnershipReason"><Derived><String>An Entrance Permit requires evidence that the applicant may perform work on this property.</String></Derived></Fact>
    <Fact path="/entranceRecordedPlanReason"><Derived><String>An Entrance Permit requires the recorded plan or applicable subdivision plan.</String></Derived></Fact>
    <Fact path="/entranceConstructionPlanReason"><Derived><Switch>
      <Case><When><Equal><Left><Dependency path="/entranceWorkType"/></Left><Right><Enum optionsPath="/entranceWorkTypeOptions">new</Enum></Right></Equal></When><Then><String>You are constructing a new entrance.</String></Then></Case>
      <Case><When><Equal><Left><Dependency path="/entranceWorkType"/></Left><Right><Enum optionsPath="/entranceWorkTypeOptions">modify</Enum></Right></Equal></When><Then><String>You are modifying an existing entrance.</String></Then></Case>
      <Case><When><Equal><Left><Dependency path="/entranceWorkType"/></Left><Right><Enum optionsPath="/entranceWorkTypeOptions">relocate</Enum></Right></Equal></When><Then><String>You are relocating an existing entrance.</String></Then></Case>
