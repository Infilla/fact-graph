    <Fact path="/contactCompany"><Writable><String/></Writable></Fact>
    <Fact path="/contactFirstName"><Writable><String/></Writable></Fact>
    <Fact path="/contactLastName"><Writable><String/></Writable></Fact>
    <Fact path="/contactEmail"><Writable><String><Limit type="Match"><String>^[^\s@]+@[^\s@]+\.[^\s@]+$</String></Limit></String></Writable></Fact>
    <Fact path="/contactPhone"><Writable><String/></Writable></Fact>
    <Fact path="/contactFilerType"><Writable><Enum optionsPath="/contactFilerTypeOptions"/></Writable></Fact>
    <Fact path="/isAuthorizedAgent"><Writable><Boolean/></Writable></Fact>
    <Fact path="/mlUoaAttached"><Writable><Boolean/></Writable></Fact>
    <Fact path="/authorizedAgentFormAttached"><Writable><Boolean/></Writable></Fact>
