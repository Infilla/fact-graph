    <!-- A utility project normally produces one permit application. -->
    <Fact path="/utilityIsPublic"><Writable><Boolean/></Writable></Fact>
    <Fact path="/utilityType"><Writable><Enum optionsPath="/utilityTypeOptions"/></Writable></Fact>
    <Fact path="/utilityWorkType"><Writable><Enum optionsPath="/utilityWorkTypeOptions"/></Writable></Fact>
    <Fact path="/utilityWorkDescription"><Writable><String/></Writable></Fact>
    <Fact path="/utilityIsEmergency"><Writable><Boolean/></Writable></Fact>
    <Fact path="/utilityJurisdiction"><Writable><Enum optionsPath="/utilityJurisdictionOptions"/></Writable></Fact>
    <Fact path="/utilityIsInDelDOTJurisdiction"><Derived><Not><Equal><Left><Dependency path="/utilityJurisdiction"/></Left><Right><Enum optionsPath="/utilityJurisdictionOptions">none</Enum></Right></Equal></Not></Derived></Fact>
    <Fact path="/utilityGroundDisturbanceSqFt"><Writable><Int><Limit type="Min"><Int>0</Int></Limit></Int></Writable></Fact>
    <Fact path="/utilityTrafficImpact"><Writable><Enum optionsPath="/utilityTrafficImpactOptions"/></Writable></Fact>
    <Fact path="/utilityHasMajorTrafficImpact"><Derived><Equal><Left><Dependency path="/utilityTrafficImpact"/></Left><Right><Enum optionsPath="/utilityTrafficImpactOptions">major</Enum></Right></Equal></Derived></Fact>
    <Fact path="/utilityHasTrafficImpact"><Derived><Not><Equal><Left><Dependency path="/utilityTrafficImpact"/></Left><Right><Enum optionsPath="/utilityTrafficImpactOptions">none</Enum></Right></Equal></Not></Derived></Fact>
    <Fact path="/utilityDuration"><Writable><Enum optionsPath="/utilityDurationOptions"/></Writable></Fact>
    <Fact path="/utilityLongerThanOneDay"><Derived><Equal><Left><Dependency path="/utilityDuration"/></Left><Right><Enum optionsPath="/utilityDurationOptions">longer</Enum></Right></Equal></Derived></Fact>
    <Fact path="/utilityRequiresTrafficControlPlan">
      <Derived><Dependency path="/anySiteRequiresTrafficControlPlan"/></Derived>
    </Fact>
    <Fact path="/utilityRequiredAnswersComplete">
      <Derived><All>
        <IsComplete><Dependency path="/utilityIsPublic"/></IsComplete>
        <IsComplete><Dependency path="/utilityType"/></IsComplete>
        <IsComplete><Dependency path="/utilityWorkType"/></IsComplete>
        <IsComplete><Dependency path="/utilityWorkDescription"/></IsComplete>
        <IsComplete><Dependency path="/utilityIsEmergency"/></IsComplete>
        <IsComplete><Dependency path="/utilityJurisdiction"/></IsComplete>
        <IsComplete><Dependency path="/utilityGroundDisturbanceSqFt"/></IsComplete>
        <IsComplete><Dependency path="/utilityTrafficImpact"/></IsComplete>
        <IsComplete><Dependency path="/utilityDuration"/></IsComplete>
        <Dependency path="/allSiteCommonAnswersComplete"/>
      </All></Derived>
    </Fact>
    <Fact path="/utilityPermitEligible">
      <Derived><Any>
        <Dependency path="/utilityIsEmergency"/>
        <All>
          <Dependency path="/allSitesGisJurisdictionEligible"/>
          <All>
            <Dependency path="/utilityIsInDelDOTJurisdiction"/>
            <Any>
              <GreaterThan><Left><Dependency path="/utilityGroundDisturbanceSqFt"/></Left><Right><Int>0</Int></Right></GreaterThan>
              <Dependency path="/utilityHasTrafficImpact"/>
              <Dependency path="/utilityLongerThanOneDay"/>
            </Any>
          </All>
        </All>
      </Any></Derived>
    </Fact>
    <Fact path="/utilityPermitType">
      <Derived><Switch>
        <Case><When><Dependency path="/utilityIsEmergency"/></When><Then><String>After-the-Fact Emergency Utility Permit</String></Then></Case>
        <Case><When><Not><Dependency path="/utilityIsInDelDOTJurisdiction"/></Not></When><Then><String>No DelDOT permit needed</String></Then></Case>
        <Case><When><GreaterThan><Left><Dependency path="/utilityGroundDisturbanceSqFt"/></Left><Right><Int>0</Int></Right></GreaterThan></When><Then><String>Utility Construction Permit</String></Then></Case>
        <Case><When><Dependency path="/utilityHasTrafficImpact"/></When><Then><String>Utility Safety Permit</String></Then></Case>
        <Case><When><Dependency path="/utilityLongerThanOneDay"/></When><Then><String>Utility Safety Permit</String></Then></Case>
        <Case><When><All>
          <Not><Dependency path="/utilityIsEmergency"/></Not>
          <Dependency path="/utilityIsInDelDOTJurisdiction"/>
          <Equal><Left><Dependency path="/utilityGroundDisturbanceSqFt"/></Left><Right><Int>0</Int></Right></Equal>
          <Not><Dependency path="/utilityHasTrafficImpact"/></Not>
          <Not><Dependency path="/utilityLongerThanOneDay"/></Not>
        </All></When><Then><String>No DelDOT permit needed</String></Then></Case>
      </Switch></Derived>
    </Fact>
    <Fact path="/wirelessPermitType"><Derived><String>Small Wireless Facility Permit</String></Derived></Fact>
    <Fact path="/utilityDrawingRequired"><Derived><True/></Derived></Fact>
    <Fact path="/utilityOccupancyAgreementRequired"><Derived><Not><Dependency path="/utilityIsPublic"/></Not></Derived></Fact>
    <Fact path="/utilityDrawingRequiredByUtility"><Derived><All><Dependency path="/utilityPermitRequested"/><Dependency path="/utilityDrawingRequired"/></All></Derived></Fact>
    <Fact path="/utilityOccupancyAgreementRequiredByUtility"><Derived><All><Dependency path="/utilityPermitRequested"/><Dependency path="/utilityOccupancyAgreementRequired"/></All></Derived></Fact>
    <Fact path="/utilityTrafficControlPlanRequiredByUtility"><Derived><All><Dependency path="/utilityPermitRequested"/><Dependency path="/utilityRequiresTrafficControlPlan"/></All></Derived></Fact>
    <Fact path="/utilityFoundationDesignRequiredByUtility"><Derived><All><Dependency path="/utilityPermitRequested"/><Dependency path="/anySiteFoundationDesignRequired"/></All></Derived></Fact>
    <Fact path="/utilityCasingSpecificationsRequiredByUtility"><Derived><All><Dependency path="/utilityPermitRequested"/><Dependency path="/anySiteCasingSpecificationsRequired"/></All></Derived></Fact>
    <Fact path="/utilityAirportFormRequiredByUtility"><Derived><All><Dependency path="/utilityPermitRequested"/><Dependency path="/anySiteAirportFormRequired"/></All></Derived></Fact>
    <Fact path="/utilityRailroadApprovalRequiredByUtility"><Derived><All><Dependency path="/utilityPermitRequested"/><Dependency path="/anySiteRailroadApprovalRequired"/></All></Derived></Fact>
    <Fact path="/utilityRailroadProximityReviewRequiredByUtility"><Derived><All><Dependency path="/utilityPermitRequested"/><Dependency path="/anySiteRailroadProximityReviewRequired"/></All></Derived></Fact>
    <Fact path="/utilityDrawingReason"><Derived><String>The reported work requires a construction, safety, or after-the-fact emergency permit.</String></Derived></Fact>
    <Fact path="/utilityOccupancyAgreementReason"><Derived><String>The utility work is not being performed by a public utility.</String></Derived></Fact>
    <Fact path="/utilityTrafficControlPlanReason"><Derived><String>The proposed work has traffic-control conditions that require a Traffic Control Plan.</String></Derived></Fact>
    <Fact path="/utilityFoundationDesignReason"><Derived><String>The utility work includes a new pole or support-structure foundation.</String></Derived></Fact>
    <Fact path="/utilityCasingSpecificationsReason"><Derived><String>The utility work includes casing.</String></Derived></Fact>
    <Fact path="/utilityAirportFormReason"><Derived><String>GIS places the work site in airport airspace.</String></Derived></Fact>
    <Fact path="/utilityRailroadApprovalReason"><Derived><String>The proposed utility work crosses over or under a railroad.</String></Derived></Fact>
    <Fact path="/utilityRailroadProximityReason"><Derived><String>GIS identifies a railroad near the utility project site.</String></Derived></Fact>
    <Fact path="/utilityDocumentScope"><Derived><String>permit</String></Derived></Fact>
    <Fact path="/utilityDrawingAttached"><Writable><Boolean/></Writable></Fact>
    <Fact path="/utilityOccupancyAgreementAttached"><Writable><Boolean/></Writable></Fact>
    <Fact path="/utilityTrafficControlPlanAttached"><Writable><Boolean/></Writable></Fact>
    <Fact path="/utilityFoundationDesignAttached"><Writable><Boolean/></Writable></Fact>
    <Fact path="/utilityCasingSpecificationsAttached"><Writable><Boolean/></Writable></Fact>
    <Fact path="/utilityAirportFormAttached"><Writable><Boolean/></Writable></Fact>
    <Fact path="/utilityRailroadApprovalAttached"><Writable><Boolean/></Writable></Fact>
    <Fact path="/utilityRailroadProximityReviewAttached"><Writable><Boolean/></Writable></Fact>
    <Fact path="/utilityDocumentsComplete"><Derived><All>
      <Dependency path="/utilityDrawingAttached"/>
      <Any><Not><Dependency path="/utilityOccupancyAgreementRequired"/></Not><Dependency path="/utilityOccupancyAgreementAttached"/></Any>
      <Any><Not><Dependency path="/utilityRequiresTrafficControlPlan"/></Not><Dependency path="/utilityTrafficControlPlanAttached"/></Any>
      <Any><Not><Dependency path="/anySiteFoundationDesignRequired"/></Not><Dependency path="/utilityFoundationDesignAttached"/></Any>
      <Any><Not><Dependency path="/anySiteCasingSpecificationsRequired"/></Not><Dependency path="/utilityCasingSpecificationsAttached"/></Any>
      <Any><Not><Dependency path="/anySiteAirportFormRequired"/></Not><Dependency path="/utilityAirportFormAttached"/></Any>
      <Any><Not><Dependency path="/anySiteRailroadApprovalRequired"/></Not><Dependency path="/utilityRailroadApprovalAttached"/></Any>
      <Any><Not><Dependency path="/anySiteRailroadProximityReviewRequired"/></Not><Dependency path="/utilityRailroadProximityReviewAttached"/></Any>
    </All></Derived></Fact>

    <!-- Entrance-permit facts consume the same project and site facts as utility rules. -->
    <Fact path="/entranceType"><Writable><Enum optionsPath="/entranceTypeOptions"/></Writable></Fact>
    <Fact path="/entranceWorkType"><Writable><Enum optionsPath="/entranceWorkTypeOptions"/></Writable></Fact>
    <Fact path="/entrancePlanningApprovalReceived"><Writable><Boolean/></Writable></Fact>
    <Fact path="/entranceExistingAdtEntering"><Writable><Int/></Writable></Fact>
    <Fact path="/entranceExistingAdtExiting"><Writable><Int/></Writable></Fact>
    <Fact path="/entrancePeakHourTrips"><Writable><Int/></Writable></Fact>
    <Fact path="/entrancePriorUse"><Writable><String/></Writable></Fact>
    <Fact path="/entranceProposedUse"><Writable><String/></Writable></Fact>
    <Fact path="/entranceStakesDate"><Writable><String/></Writable></Fact>
    <Fact path="/entranceTaxParcelId"><Writable><String/></Writable></Fact>
    <Fact path="/entranceTotalAdt"><Derived><Add><Dependency path="/entranceExistingAdtEntering"/><Dependency path="/entranceExistingAdtExiting"/></Add></Derived></Fact>
    <Fact path="/entranceTrafficOperationalAnalysisRequired"><Derived><GreaterThanOrEqual><Left><Dependency path="/entranceTotalAdt"/></Left><Right><Int>200</Int></Right></GreaterThanOrEqual></Derived></Fact>
    <Fact path="/entrancePreSubmittalMeetingRequired"><Derived><Any>
      <GreaterThanOrEqual><Left><Dependency path="/entranceTotalAdt"/></Left><Right><Int>500</Int></Right></GreaterThanOrEqual>
      <GreaterThan><Left><Dependency path="/entrancePeakHourTrips"/></Left><Right><Int>50</Int></Right></GreaterThan>
    </Any></Derived></Fact>
    <Fact path="/entrancePedestrianEvidenceRequired"><Derived><GreaterThanOrEqual><Left><Dependency path="/entranceTotalAdt"/></Left><Right><Int>2000</Int></Right></GreaterThanOrEqual></Derived></Fact>
    <Fact path="/crossPermitCoordinationRequired"><Derived><All><Dependency path="/entrancePermitRequested"/><Dependency path="/anySiteHasUndergroundWork"/></All></Derived></Fact>
    <Fact path="/entrancePermitEligible"><Derived><All><Dependency path="/entrancePermitRequested"/><Dependency path="/allSitesGisJurisdictionEligible"/></All></Derived></Fact>
    <Fact path="/entrancePermitType"><Derived><Switch>
      <Case><When><Dependency path="/entrancePermitEligible"/></When><Then><String>Entrance Permit</String></Then></Case>
      <Case><When><All><Dependency path="/entrancePermitRequested"/><IsComplete><Dependency path="/allSitesGisJurisdictionEligible"/></IsComplete><Not><Dependency path="/allSitesGisJurisdictionEligible"/></Not></All></When><Then><String>No DelDOT Entrance Permit needed</String></Then></Case>
    </Switch></Derived></Fact>
    <Fact path="/entranceRequiredAnswersComplete"><Derived><Any>
      <Not><Dependency path="/entrancePermitRequested"/></Not>
      <All>
        <IsComplete><Dependency path="/entranceType"/></IsComplete>
        <IsComplete><Dependency path="/entranceWorkType"/></IsComplete>
        <IsComplete><Dependency path="/entrancePlanningApprovalReceived"/></IsComplete>
        <IsComplete><Dependency path="/entranceExistingAdtEntering"/></IsComplete>
        <IsComplete><Dependency path="/entranceExistingAdtExiting"/></IsComplete>
        <IsComplete><Dependency path="/entrancePeakHourTrips"/></IsComplete>
        <IsComplete><Dependency path="/entrancePriorUse"/></IsComplete>
        <IsComplete><Dependency path="/entranceProposedUse"/></IsComplete>
        <IsComplete><Dependency path="/entranceStakesDate"/></IsComplete>
        <IsComplete><Dependency path="/entranceTaxParcelId"/></IsComplete>
        <Dependency path="/allSitesGisJurisdictionEligible"/>
      </All>
    </Any></Derived></Fact>
    <Fact path="/entrancePlanningApprovalAttached"><Writable><Boolean/></Writable></Fact>
    <Fact path="/entranceOwnershipAttached"><Writable><Boolean/></Writable></Fact>
    <Fact path="/entranceRecordedPlanAttached"><Writable><Boolean/></Writable></Fact>
