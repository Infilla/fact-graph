    <Fact path="/authorizedAgentFormRequiredByWireless"><Derived><All><Dependency path="/authorizedAgentFormRequired"/><Dependency path="/isSmallWirelessApplication"/></All></Derived></Fact>
    <Fact path="/authorizedAgentFormRequiredByEntrance"><Derived><All><Dependency path="/authorizedAgentFormRequired"/><Dependency path="/entrancePermitRequested"/></All></Derived></Fact>
    <Fact path="/mlUoaRequiredByWireless"><Derived><Dependency path="/isSmallWirelessApplication"/></Derived></Fact>
    <Fact path="/authorizedAgentFormReason"><Derived><String>You are filing as an authorized agent for this project.</String></Derived></Fact>
    <Fact path="/mlUoaReason"><Derived><String>Small wireless facilities require a project-wide Master Limited Use &amp; Occupancy Agreement.</String></Derived></Fact>
    <Fact path="/authorizedAgentFormScope"><Derived><String>project</String></Derived></Fact>
    <Fact path="/mlUoaScope"><Derived><String>project</String></Derived></Fact>
