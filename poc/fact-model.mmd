flowchart LR
  classDef source fill:#eaf5fb,stroke:#1769aa,color:#12385b,stroke-width:1.5px
  classDef external fill:#eef3ff,stroke:#536fc4,color:#26366f,stroke-width:1.5px,stroke-dasharray:5 3
  classDef derived fill:#eef9f3,stroke:#19734a,color:#104b32,stroke-width:1.5px
  classDef complete fill:#fff8df,stroke:#c58a00,color:#4a3600,stroke-width:1.5px
  classDef output fill:#f1effa,stroke:#6852a3,color:#30225c,stroke-width:1.5px

  subgraph PROJECT["Shared project"]
    ACTIVITIES["Activity facts"]:::source
    DETERMINANTS["Permit-determining answers<br/>emergency · jurisdiction · disturbance<br/>traffic · duration · wireless count"]:::source
    PACKAGE_DONE["/permitPackageDetermined"]:::complete
    NEEDED["Five explicit outcomes<br/>/utilityConstructionPermitNeeded<br/>/utilitySafetyPermitNeeded<br/>/emergencyUtilityPermitNeeded<br/>/smallWirelessPermitsNeeded<br/>/entrancePermitNeeded"]:::derived
    PERMIT_COUNT["/requiredPermitCount<br/>includes /wirelessPermitCount"]:::derived
    QUESTION_MANIFEST["Graph form manifest<br/>/askSharedApplicationQuestions<br/>/askProjectSiteQuestions<br/>/askGeneralUtilityQuestions<br/>/askWirelessNodeQuestions<br/>/askEntranceQuestions<br/>/askDocumentQuestions"]:::derived
    CONTACT["/projectName + /contact*"]:::source
    SHARED["/sharedApplicationFactsComplete"]:::complete
    ACTIVITIES --> SHARED
    ACTIVITIES --> DETERMINANTS --> PACKAGE_DONE --> NEEDED --> PERMIT_COUNT --> QUESTION_MANIFEST
    CONTACT --> SHARED
  end

  subgraph SITES["/sites collection"]
    SITE_SOURCE["Applicant site facts<br/>location · construction · traffic"]:::source
    GIS_SOURCE["External GIS facts<br/>state road · limited access<br/>airport · railroad"]:::external
    GIS_JUR["*/gisJurisdictionEligible"]:::derived
    GIS_REVIEWS["*/gisSpecialReviewRequired<br/>*/airportReviewRequired<br/>*/railroadReviewRequired"]:::derived
    TCP["*/requiresTrafficControlPlan"]:::derived
    ANY_TCP["/anySiteRequiresTrafficControlPlan"]:::derived
    GIS_SOURCE --> GIS_JUR
    GIS_SOURCE --> GIS_REVIEWS
    SITE_SOURCE --> TCP --> ANY_TCP
  end

  subgraph GENERAL["Other listed utility work"]
    U_RAW["Raw answers<br/>/utilityJurisdiction<br/>/utilityTrafficImpact<br/>/utilityDuration"]:::source
    U_DERIVED["Derived jurisdiction, traffic<br/>and duration booleans"]:::derived
    U_PERMIT["/utilityPermitType<br/>Emergency · Construction · Safety · None"]:::derived
    U_ANSWERS["/utilityRequiredAnswersComplete"]:::complete
    U_DOCS["/utilityDocumentsComplete"]:::complete
    U_DONE["/generalUtilityRequirementsSatisfied"]:::complete
    U_RAW --> U_DERIVED --> U_PERMIT
    U_RAW --> U_ANSWERS
    ANY_TCP --> U_DOCS
    GIS_REVIEWS --> U_DOCS
    U_ANSWERS --> U_DONE
    U_PERMIT --> U_DONE
    U_DOCS --> U_DONE
  end

  subgraph WIRELESS["Small wireless · per node"]
    NODE["Wireless sites/*<br/>equipment · height · impacts"]:::source
    SIZE["*/sizeEligible"]:::derived
    HEIGHT["*/heightEligible"]:::derived
    QUAL["*/statutoryQualificationSatisfied"]:::derived
    NODE_ELIG["*/permitEligible"]:::derived
    NODE_DOCS["*/documentsComplete"]:::complete
    NODE_READY["*/readyToSubmit"]:::complete
    ALL_NODES["/allWirelessNodesComplete"]:::complete
    W_DONE["/smallWirelessRequirementsSatisfied"]:::complete
    FEE["/wirelessTotalFee<br/>collection size × $100"]:::derived
    NODE --> SIZE --> QUAL
    NODE --> HEIGHT --> QUAL
    QUAL --> NODE_ELIG
    GIS_JUR --> NODE_ELIG
    GIS_REVIEWS --> NODE_DOCS
    TCP --> NODE_DOCS
    NODE_ELIG --> NODE_READY
    NODE_DOCS --> NODE_READY --> ALL_NODES --> W_DONE
    NODE --> FEE
  end

  subgraph ENTRANCE["Entrance"]
    E_SOURCE["Entrance type · work<br/>traffic · parcel · property use"]:::source
    E_TRAFFIC["/entranceTotalAdt<br/>conditional review facts"]:::derived
    E_PERMIT["/entrancePermitType"]:::derived
    E_DOCS["/entranceDocumentsComplete"]:::complete
    E_DONE["/entranceRequirementsSatisfied"]:::complete
    E_SOURCE --> E_TRAFFIC --> E_DOCS
    E_SOURCE --> E_PERMIT
    GIS_JUR --> E_DONE
    E_DOCS --> E_DONE
  end

  DETERMINANTS --> U_RAW
  QUESTION_MANIFEST --> CONTACT
  QUESTION_MANIFEST --> SITE_SOURCE
  QUESTION_MANIFEST --> NODE
  QUESTION_MANIFEST --> E_SOURCE
  SHARED --> COMPLETE["/applicationComplete"]:::complete
  PROJECT_DOCS["/projectDocumentsComplete"]:::complete --> COMPLETE
  U_DONE --> COMPLETE
  W_DONE --> COMPLETE
  E_DONE --> COMPLETE
  COMPLETE --> READY["/readyToSubmit"]:::derived
  ATTEST["/attestationsAccepted"]:::source --> READY
  READY --> PACKAGE["One submission package<br/>all derived permits"]:::output
  FEE --> PACKAGE
